import GaussianHermitePrimePolynomial
import GaussianD4MinorExponents

/-! The Hermite comparison gives one copy of the matching prime, using just
the ideal generated by its values at integral nodes. -/

namespace AlpogeSuperZeta

open Polynomial UniqueFactorizationMonoid
open scoped Classical

noncomputable section

/-- The numerator of the Hermite interpolation reading minus the specified
automorphism at the same input. -/
def hermiteFrobeniusValue {R : Type*} [CommRing R] (m : ℕ) (σ : R →+* R) (a : R) : R :=
  (hermitePrimePolynomial m).eval₂ (Int.castRingHom R) a -
    (hermitePrimeScale m : R) * σ a

def hermiteFrobeniusIdeal {R : Type*} [CommRing R] (m : ℕ) (σ : R →+* R) : Ideal R :=
  Ideal.span (Set.range (hermiteFrobeniusValue m σ))

private theorem hermitePrimeScale_ne_zero_in_residue {K : Type*} [Field K] {m p : ℕ}
    [CharP K p] (hp : p.Prime) (hm₀ : 0 < m) (hm : m ≤ p) :
    (hermitePrimeScale m : K) ≠ 0 := by
  have hnz : (((m - 1).factorial : ℕ) : K) ≠ 0 := by
    intro h
    have he := (CharP.cast_eq_zero_iff K p _).mp h
    have hh := (hp.dvd_factorial.mp he)
    omega
  simpa only [hermitePrimeScale, Int.cast_pow, Int.cast_natCast] using pow_ne_zero 2 hnz

private theorem hermiteFrobeniusValue_residue {R : Type*} [CommRing R]
    (P : Ideal R) [P.IsMaximal] (σ : R →+* R) {m p : ℕ} [CharP (R ⧸ P) p]
    (hp : p.Prime) (hm : m ≤ p) (hpm : p < 2 * m) (a : R) :
    Ideal.Quotient.mk P (hermiteFrobeniusValue m σ a) =
      (hermitePrimeScale m : R ⧸ P) * ((Ideal.Quotient.mk P a) ^ p - Ideal.Quotient.mk P (σ a)) := by
  let : Field (R ⧸ P) := Ideal.Quotient.field P
  let f := Int.castRingHom R
  let q := Ideal.Quotient.mk P
  have hf : q.comp f = Int.castRingHom (R ⧸ P) := by
    ext z
    exact map_intCast q z
  have hpoly := hermitePrimePolynomial_mod_prime (K := R ⧸ P) hp hm hpm
  rw [← hf, ← Polynomial.map_map] at hpoly
  have hv := congrArg (fun F : (R ⧸ P)[X] => F.eval (q a)) hpoly
  rw [eval_map_apply, ← eval₂_eq_eval_map, eval_mul, eval_C, eval_pow, eval_X] at hv
  change q ((hermitePrimePolynomial m).eval₂ f a - (hermitePrimeScale m : R) * σ a) = _
  rw [map_sub, hv, map_mul, map_intCast, mul_sub]

private theorem hermiteFrobeniusIdeal_le_iff {R : Type*} [CommRing R]
    (P : Ideal R) [P.IsMaximal] (σ : R →+* R) {m p : ℕ} [CharP (R ⧸ P) p]
    (hp : p.Prime) (hm : m ≤ p) (hpm : p < 2 * m) :
    hermiteFrobeniusIdeal m σ ≤ P ↔
      ∀ a : R, Ideal.Quotient.mk P (σ a) = (Ideal.Quotient.mk P a) ^ p := by
  let : Field (R ⧸ P) := Ideal.Quotient.field P
  have hm₀ : 0 < m := by omega
  have hd := hermitePrimeScale_ne_zero_in_residue (K := R ⧸ P) hp hm₀ hm
  rw [hermiteFrobeniusIdeal, Ideal.span_le]
  constructor
  · intro h a
    have he := Ideal.Quotient.eq_zero_iff_mem.mpr (h ⟨a, rfl⟩)
    rw [hermiteFrobeniusValue_residue P σ hp hm hpm] at he
    exact (sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_left hd)).symm
  · rintro h _ ⟨a, rfl⟩
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [hermiteFrobeniusValue_residue P σ hp hm hpm, h a, sub_self, mul_zero]

private theorem hermiteFrobeniusIdeal_not_le_sq {R : Type*} [CommRing R]
    (P : Ideal R) [P.IsMaximal] (σ : R →+* R) {m p : ℕ} [CharP (R ⧸ P) p]
    (hp : p.Prime) (hm₀ : 0 < m) (hm : m ≤ p) (hUnramified : (p : R) ∉ P ^ 2) :
    ¬ hermiteFrobeniusIdeal m σ ≤ P ^ 2 := by
  let : Field (R ⧸ P) := Ideal.Quotient.field P
  have hd : (hermitePrimeScale m : R) ∉ P := by
    intro he
    have hz := Ideal.Quotient.eq_zero_iff_mem.mpr he
    rw [map_intCast] at hz
    exact hermitePrimeScale_ne_zero_in_residue (K := R ⧸ P) hp hm₀ hm hz
  have hpP : (p : R) ∈ P :=
    Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_natCast, CharP.cast_eq_zero (R ⧸ P) p])
  have hW : (hermitePrimePolynomial m).eval₂ (Int.castRingHom R) (p : R) ∈ P ^ 2 := by
    obtain ⟨F, hF⟩ := hermitePrimePolynomial_X_sq_dvd hm₀
    rw [hF, eval₂_mul, eval₂_pow, eval₂_X]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hpP 2)
  intro h
  have hg : hermiteFrobeniusValue m σ (p : R) ∈ P ^ 2 :=
    h (Ideal.subset_span ⟨(p : R), rfl⟩)
  rw [hermiteFrobeniusValue, map_natCast] at hg
  have hprod := (P ^ 2).sub_mem hW hg
  rw [sub_sub_cancel] at hprod
  exact hUnramified ((Ideal.IsMaximal.mul_mem_pow P hprod).resolve_left hd)

/-- In the dyadic prime band the entire value ideal has exponent one
at a matching unramified prime and zero elsewhere. -/
theorem hermiteFrobeniusIdeal_count {R : Type*} [CommRing R] [IsDedekindDomain R]
    (P : Ideal R) [P.IsMaximal] (σ : R →+* R) {m p : ℕ} [CharP (R ⧸ P) p]
    (hp : p.Prime) (hm : m ≤ p) (hpm : p < 2 * m) (hUnramified : (p : R) ∉ P ^ 2) :
    (normalizedFactors (hermiteFrobeniusIdeal m σ)).count P =
      if (∀ a : R, Ideal.Quotient.mk P (σ a) = (Ideal.Quotient.mk P a) ^ p) then 1 else 0 := by
  classical
  have hle := hermiteFrobeniusIdeal_le_iff P σ hp hm hpm
  by_cases hf : ∀ a : R, Ideal.Quotient.mk P (σ a) = (Ideal.Quotient.mk P a) ^ p
  · rw [if_pos hf]
    apply Ideal.count_normalizedFactors_eq
    · simpa only [pow_one] using hle.mpr hf
    · exact hermiteFrobeniusIdeal_not_le_sq P σ hp (by omega) hm hUnramified
  · rw [if_neg hf]
    apply Ideal.count_normalizedFactors_eq
    · simp
    · simpa only [zero_add, pow_one] using (fun h => hf (hle.mp h))

#print axioms hermiteFrobeniusValue_residue
#print axioms hermiteFrobeniusIdeal_not_le_sq
#print axioms hermiteFrobeniusIdeal_count

end
end AlpogeSuperZeta
