import GaussianCommonDivisor

/-! The ideal generated by the quadratic coefficient over every Gaussian
starting value. Its containment in a prime is read at that same prime
by the archived quartic character. -/

namespace AlpogeSuperZeta

open QuarticModel QuadraticAlgebra

/-- The coefficient of the quadratic generator in (h + ω)^n. -/
def gaussianPowerCoefficient (h : GaussianInt) (n : ℕ) : GaussianInt :=
  ((⟨h, 1⟩ : QuadraticAlgebra GaussianInt gaussianDiscriminant 0) ^ n).im

theorem gaussianPowerCoefficient_at_marked_seed (n : ℕ) :
    gaussianPowerCoefficient ⟨1, 1⟩ n = gaussianMarkedCoefficient n :=
  rfl

/-- The common divisor ideal before removing the finitely many bad primes. -/
def gaussianCommonDivisorIdeal (n : ℕ) : Ideal GaussianInt :=
  Ideal.span (Set.range (gaussianPowerCoefficient · n))

/-- Apply a base ring map to both coordinates of the archived quadratic. -/
def mapGaussianQuadratic {R : Type*} [CommRing R] (f : GaussianInt →+* R) :
    QuadraticAlgebra GaussianInt gaussianDiscriminant 0 →+*
      QuadraticAlgebra R (f gaussianDiscriminant) 0 where
  toFun x := ⟨f x.re, f x.im⟩
  map_one' := by ext <;> simp
  map_zero' := by ext <;> simp
  map_add' := by intro x y; ext <;> simp
  map_mul' := by intro x y; ext <;> simp

theorem mapGaussianQuadratic_star {R : Type*} [CommRing R] (f : GaussianInt →+* R)
    (z : QuadraticAlgebra GaussianInt gaussianDiscriminant 0) :
    mapGaussianQuadratic f (star z) = star (mapGaussianQuadratic f z) := by
  ext <;> simp [mapGaussianQuadratic]

theorem gaussianPowerCoefficient_map {R : Type*} [CommRing R]
    (f : GaussianInt →+* R) (h : GaussianInt) (n : ℕ) :
    f (gaussianPowerCoefficient h n) =
      ((⟨f h, 1⟩ : QuadraticAlgebra R (f gaussianDiscriminant) 0) ^ n).im := by
  change (mapGaussianQuadratic f ((⟨h, 1⟩ : QuadraticAlgebra GaussianInt
    gaussianDiscriminant 0) ^ n)).im = _
  have he : mapGaussianQuadratic f (⟨h, 1⟩ : QuadraticAlgebra GaussianInt
    gaussianDiscriminant 0) = ⟨f h, 1⟩ := by
    ext <;> simp [mapGaussianQuadratic]
  rw [map_pow, he]

private theorem gaussianCommonDivisor_le_ker_iff {F : Type*} [Field F] [Fintype F] [DecidableEq F]
    (f : GaussianInt →+* F) (hf : Function.Surjective f) (ht : (2 : F) ≠ 0)
    (hd : f gaussianDiscriminant ≠ 0) {n : ℕ} (hn : 0 < n) :
    gaussianCommonDivisorIdeal n ≤ RingHom.ker f ↔
      quadraticChar F (f gaussianDiscriminant) = -1 ∧ Fintype.card F + 1 ∣ n := by
  rw [gaussianCommonDivisorIdeal, Ideal.span_le, quadraticChar_neg_one_iff_not_isSquare,
    ← quadratic_coefficient_all_values_zero_iff ht hd hn]
  constructor
  · intro h s
    obtain ⟨x, rfl⟩ := hf s
    rw [← gaussianPowerCoefficient_map]
    have hx := h (Set.mem_range_self x)
    change gaussianPowerCoefficient x n ∈ RingHom.ker f at hx
    exact RingHom.mem_ker.mp hx
  · rintro h _ ⟨x, rfl⟩
    change gaussianPowerCoefficient x n ∈ RingHom.ker f
    rw [RingHom.mem_ker, gaussianPowerCoefficient_map]
    exact h (f x)

theorem gaussian_natCast_mem_prime_iff {p : ℕ} [Fact p.Prime]
    (I : ↥(gaussianPrimesAbove p)) (n : ℕ) :
    (n : GaussianInt) ∈ I.val ↔ p ∣ n := by
  have : I.val.LiesOver (Ideal.span {(p : ℤ)}) :=
    ((mem_gaussianPrimesAbove p).mp I.property).2
  have h := Ideal.mem_of_liesOver I.val (Ideal.span {(p : ℤ)}) (n : ℤ)
  rwa [Ideal.mem_span_singleton, Int.natCast_dvd_natCast, map_natCast, iff_comm] at h

theorem gaussian_two_not_mem_odd_prime {p : ℕ} [Fact p.Prime]
    (hp : p ≠ 2) (I : ↥(gaussianPrimesAbove p)) :
    (2 : GaussianInt) ∉ I.val := fun h =>
  hp ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) Nat.prime_two).mp
    ((gaussian_natCast_mem_prime_iff I 2).mp h))

theorem gaussian_discriminant_not_mem_good_prime {p : ℕ} [Fact p.Prime]
    (hD : p.Coprime 26509772707289) (I : ↥(gaussianPrimesAbove p)) :
    gaussianDiscriminant ∉ I.val := by
  intro hmem
  have he := I.val.mul_mem_left (star gaussianDiscriminant) hmem
  have hprod : star gaussianDiscriminant * gaussianDiscriminant =
      (26509772707289 : GaussianInt) := by decide +kernel
  rw [hprod] at he
  have hdvd := (gaussian_natCast_mem_prime_iff I 26509772707289).mp he
  exact (Fact.out : p.Prime).ne_one (Nat.dvd_one.mp (hD.gcd_eq_one ▸ Nat.dvd_gcd dvd_rfl hdvd))

attribute [local instance] Ideal.Quotient.field

/-- At each good Gaussian prime of the actual quartic, including
degree two, the common divisor has that prime factor exactly when the
archived sign is negative and the norm plus one divides the index. -/
theorem gaussianCommonDivisor_le_prime_iff {p : ℕ} [Fact p.Prime]
    (hp : p ≠ 2) (hD : p.Coprime 26509772707289)
    (I : ↥(gaussianPrimesAbove p)) {n : ℕ} (hn : 0 < n) :
    gaussianCommonDivisorIdeal n ≤ I.val ↔
      archivedIdealCharacter I.val = -1 ∧ I.val.absNorm + 1 ∣ n := by
  classical
  have : I.val.IsMaximal := gaussianPrimesAbove_isMaximal I.property
  let E := GaussianInt ⧸ I.val
  have : Finite E := gaussian_finiteQuotient _ (gaussianPrimesAbove_ne_bot I.property)
  let : Fintype E := Fintype.ofFinite E
  let f := Ideal.Quotient.mk I.val
  have ht : (2 : E) ≠ 0 := by
    intro he
    apply gaussian_two_not_mem_odd_prime hp I
    exact Ideal.Quotient.eq_zero_iff_mem.mp (by simpa only [map_ofNat] using he)
  have hd : f gaussianDiscriminant ≠ 0 := fun h =>
    gaussian_discriminant_not_mem_good_prime hD I (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have hnorm : Fintype.card E = I.val.absNorm := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  have hχ : quadraticChar E (f gaussianDiscriminant) = archivedIdealCharacter I.val := by
    rw [← quarticDiscriminantSign_eq_archivedIdealCharacter p I]
    simp only [quarticDiscriminantSign, if_neg ht]
    rfl
  have htest := gaussianCommonDivisor_le_ker_iff f Ideal.Quotient.mk_surjective ht hd hn
  rwa [Ideal.mk_ker, hχ, hnorm] at htest

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- The factor of five from the single fixed start at index 72
disappears from the common divisor on both Gaussian branches. -/
theorem gaussianCommonDivisor_no_prime_above_five_at_72
    (I : ↥(gaussianPrimesAbove 5)) : ¬gaussianCommonDivisorIdeal 72 ≤ I.val := by
  have branch (r : ZMod 5) (hr : r ^ 2 = -1) (x : GaussianInt)
      (hx : gaussianResidue r hr (gaussianPowerCoefficient x 72) ≠ 0) :
      ¬gaussianCommonDivisorIdeal 72 ≤ gaussianPrimeAt r hr := by
    intro h
    exact hx (h (Ideal.subset_span (Set.mem_range_self x)))
  have hpos : (2 : ZMod 5) ^ 2 = -1 := by decide +kernel
  have hneg : (-2 : ZMod 5) ^ 2 = -1 := by decide +kernel
  have bpos : gaussianResidue (2 : ZMod 5) hpos (gaussianPowerCoefficient 1 72) ≠ 0 := by
    rw [gaussianPowerCoefficient_map, map_one, gaussianResidue_discriminant]
    change ((⟨1, 1⟩ : QuadraticAlgebra (ZMod 5) 1 0) ^ 72).im ≠ 0
    decide +kernel
  have bneg : gaussianResidue (-2 : ZMod 5) hneg (gaussianPowerCoefficient 2 72) ≠ 0 := by
    rw [gaussianPowerCoefficient_map, map_ofNat, gaussianResidue_discriminant]
    change ((⟨2, 1⟩ : QuadraticAlgebra (ZMod 5) 4 0) ^ 72).im ≠ 0
    decide +kernel
  have hcases (J : Ideal GaussianInt) (hj : J ∈ gaussianPrimesAbove 5) :
      J = gaussianPrimeAt 2 hpos ∨ J = gaussianPrimeAt (-2) hneg := by
    simpa only [split_gaussian_primes (by decide : 5 ≠ 2) _ hpos hneg,
      Finset.mem_insert, Finset.mem_singleton] using hj
  rcases hcases I.val I.property with he | he
  · rw [he]
    exact branch 2 hpos 1 bpos
  · rw [he]
    exact branch (-2) hneg 2 bneg

#print axioms gaussianPowerCoefficient_map
#print axioms gaussian_natCast_mem_prime_iff
#print axioms gaussianCommonDivisor_le_prime_iff
#print axioms gaussianCommonDivisor_no_prime_above_five_at_72

end AlpogeSuperZeta
