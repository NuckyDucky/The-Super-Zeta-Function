def expSmall (a : Box) : Box := widen (horner a expCoefficients) 1

def expFixed (a : Box) : Box := squareSteps 7 (expSmall (divInt a 128))

def cosSinSmall (a : Box) : Box × Box :=
  let squared := mul a a
  (widen (horner squared cosCoefficients) 1,
   widen (mul a (horner squared sinCoefficients)) 1)

def doubledAngle (p : Box × Box) : Box × Box :=
  let (c,s) := p
  (sub (mul c c) (mul s s), mul (constant 2) (mul s c))

def piBox : Box := ⟨3141592653589793238460000, 3141592653589793238470000⟩

def phaseTurn (a : Box) : Int :=
  let center := 3141592653589793238462643
  (a.lo+center)/(2*center)

def reducedPhase (a : Box) : Box :=
  sub a (mul (constant (2*phaseTurn a)) piBox)

def cosSinFixed (a : Box) : Box × Box :=
  doubledAngle (doubledAngle (cosSinSmall (divInt (reducedPhase a) 4)))

def logGapFixed (q : Box) : Box :=
  let t := horner (mul q q) oddReciprocals
  widen (mul (constant (-2)) (mul q t)) 2

def inUnit (a : Box) : Bool :=
  decide (-scale ≤ a.lo ∧ a.hi ≤ scale)

def inLogDomain (q : Box) : Bool :=
  decide (0 ≤ q.lo ∧ 2*q.hi ≤ scale)

def determinants (x b : Box) : Box × Box :=
  let b2 := mul b b
  let t := nonnegative (sub (constant 1) b2)
  let evenPart := add (mul t t) (mul (add (constant 3) (mul (constant 4) (mul x x))) b2)
  let oddPart := nonnegative (mul (constant 2) (mul (mul x b) t))
  (evenPart,oddPart)

def densityBoxes (numerator : Int) : Option (Box × Box) :=
  let u := fromRatio numerator 524288
  let x := expFixed u
  let b := expFixed (neg x)
  let (a,o) := determinants x b
  if a.lo ≤ 0 then none else
    let q := divPositive o a
    let phase := mul (fromRatio 7067363 500000) u
    if inLogDomain q && inUnit (divInt (reducedPhase phase) 4) then
      let amplitude := mul (expFixed (divInt (neg u) 2)) (logGapFixed q)
      let (c,s) := cosSinFixed phase
      some (mul amplitude c, mul amplitude (neg s))
    else none

def checkDensity (numerator targetRe targetIm : Int) : Bool :=
  match densityBoxes numerator with
  | none => false
  | some (r,i) => fitsSample r targetRe && fitsSample i targetIm

end DottieOriented.NativeSpectrum.MellinFixed
