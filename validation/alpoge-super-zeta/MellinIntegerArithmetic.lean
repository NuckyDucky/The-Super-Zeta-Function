def weightNumerator (j : Nat) : Int := weightNumerators.getD j 0

def coordinateNumerator (i j : Nat) : Int :=
  8192 * (i : Int) - 16773120 + nodeNumerators.getD j 0

def component (b : Bool) (v : Sample) : Int :=
  if b then v.2 else v.1

def sampleAt (column : Column) (b : Bool) (i : Nat) : Int :=
  component b (column.getD i (0,0))

def sumN (f : Nat → Int) : Nat → Int
  | 0 => 0
  | n+1 => sumN f n + f n

def columnMoment (column : Column) (block j : Nat) (b : Bool) (k : Nat) : Int :=
  sumN (fun i => (-2 * coordinateNumerator (64*block+i) j)^k * sampleAt column b i) 64

def scanColumn (f : Nat → Sample → Int) (i : Nat) : Column → Int
  | [] => 0
  | v :: vs => f i v + scanColumn f (i+1) vs

def scannedMoment (column : Column) (block j : Nat) (b : Bool) (k : Nat) : Int :=
  scanColumn (fun i v => (-2 * coordinateNumerator (64*block+i) j)^k * component b v) 0 column

def rawMoment (columns : Block) (block : Nat) (b : Bool) (k : Nat) : Int :=
  sumN (fun j => weightNumerator j * columnMoment (columns j) block j b k) 25

def reportedMoment (counts : Array Int) (b : Bool) (k : Nat) : Int :=
  counts.getD ((if b then 4 else 0) + k) 0

private def checkMoments (f : Bool → Nat → Int) (counts : Array Int) : Bool :=
  [false, true].all (fun b => (List.range 4).all (fun k => decide (f b k = reportedMoment counts b k)))

private theorem checkMoments_correct {f : Bool → Nat → Int} {counts : Array Int}
    (h : checkMoments f counts = true) (b : Bool) {k : Nat} (hk : k < 4) :
    f b k = reportedMoment counts b k := by
  have h2 := List.all_eq_true.mp h b (by cases b <;> simp)
  exact of_decide_eq_true (List.all_eq_true.mp h2 k (List.mem_range.mpr hk))

def checkedColumn (column : Column) (counts : Array Int) (block j : Nat) : Bool :=
  decide (column.length = 64 ∧ counts.size = 8) && checkMoments (scannedMoment column block j) counts

theorem checkedColumn_length {column : Column} {counts : Array Int} {block j : Nat}
    (h : checkedColumn column counts block j = true) :
    column.length = 64 := (of_decide_eq_true (Bool.and_eq_true_iff.mp h).1 : _ ∧ _).1

theorem checkedColumn_correct {column : Column} {counts : Array Int} {block j k : Nat}
    (h : checkedColumn column counts block j = true) (b : Bool) (hk : k < 4) :
    scannedMoment column block j b k = reportedMoment counts b k :=
  checkMoments_correct (Bool.and_eq_true_iff.mp h).2 b hk

def weightedReported (counts : Nat → Array Int) (b : Bool) (k : Nat) : Int :=
  sumN (fun j => weightNumerator j * reportedMoment (counts j) b k) 25

def checkedBlockTotals (counts : Nat → Array Int) (totals : Array Int) : Bool :=
  decide (totals.size = 8) && checkMoments (weightedReported counts) totals

theorem checkedBlockTotals_correct {counts : Nat → Array Int} {totals : Array Int} {k : Nat}
    (h : checkedBlockTotals counts totals = true) (b : Bool) (hk : k < 4) :
    weightedReported counts b k = reportedMoment totals b k :=
  checkMoments_correct (Bool.and_eq_true_iff.mp h).2 b hk

#print axioms checkedColumn_correct
#print axioms checkedBlockTotals_correct

end DottieOriented.NativeSpectrum.MellinInteger
