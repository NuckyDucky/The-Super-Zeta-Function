/-! Integer arithmetic for the 37 blocks of the fixed Dottie Mellin partition. -/

namespace DottieOriented.NativeSpectrum.MellinInteger

abbrev Sample := Int × Int
abbrev Column := List Sample
abbrev Block := Nat → Column

