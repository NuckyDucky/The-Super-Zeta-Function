def node (j : Fin 25) : ℚ := nodeTable.getD j.val 0
def weight (j : Fin 25) : ℚ := weightTable.getD j.val 0

set_option maxRecDepth 28000 in
set_option maxHeartbeats 0 in
theorem rule_certified :
    (∀ j : Fin 25, |node j| ≤ 1 ∧ 0 ≤ weight j) ∧
    (∑ j : Fin 25, weight j) = 2 ∧
    (∀ k : Fin 25, (∑ j : Fin 25, weight j * (node j)^k.val) =
      (1-(-1:ℚ)^(k.val+1))/((k.val:ℚ)+1)) := by
  decide +kernel

theorem error_25_unit {f : ℂ → ℂ} {M : ℝ}
    (hf : DifferentiableOn ℂ f (Metric.closedBall 0 8))
    (hM : ∀ z ∈ Metric.sphere 0 8, ‖f z‖ ≤ M) :
    ‖(∫ u in (-1:ℝ)..1, f (u:ℂ)) -
      ∑ j : Fin 25, ((weight j:ℝ):ℂ)*f ((node j:ℝ):ℂ)‖ ≤
      4*M*(1/8)^25/(1-1/8) := by
  have hnodes (j : Fin 25) (_ : j ∈ Finset.univ) : |(node j:ℝ)| ≤ 1 := by
    exact_mod_cast (rule_certified.1 j).1
  have hweights (j : Fin 25) (_ : j ∈ Finset.univ) : 0 ≤ (weight j:ℝ) := by
    exact_mod_cast (rule_certified.1 j).2
  have hsum : (∑ j : Fin 25, (weight j:ℝ)) = 2 := by
    exact_mod_cast rule_certified.2.1
  have hm (k : ℕ) (hk : k < 25) :
      (∑ j : Fin 25, (weight j:ℝ)*(node j:ℝ)^k) = (1-(-1:ℝ)^(k+1))/(k+1) := by
    exact_mod_cast rule_certified.2.2 (⟨k,hk⟩ : Fin 25)
  simpa only [NNReal.coe_ofNat, one_div] using
    error_unit Finset.univ (fun j => (node j:ℝ)) (fun j => (weight j:ℝ))
      hnodes hweights hsum (n := 25) hm (R := 8) (by norm_num) hf hM

theorem error_25_panel {f : ℂ → ℂ} {c h M : ℝ}
    (hh : 0 < h) (hf : DifferentiableOn ℂ f (Metric.closedBall (c:ℂ) (8*h)))
    (hM : ∀ z ∈ Metric.sphere (c:ℂ) (8*h), ‖f z‖ ≤ M) :
    ‖(∫ u in (c-h)..(c+h), f (u:ℂ)) -
      (h:ℂ)*∑ j : Fin 25, ((weight j:ℝ):ℂ)*f ((c+h*(node j:ℝ):ℝ):ℂ)‖ ≤
      h*(4*M*(1/8)^25/(1-1/8)) := by
  let p := fun z : ℂ => (c:ℂ)+(h:ℂ)*z
  have hdist (z : ℂ) : dist (p z) (c:ℂ) = h * ‖z‖ := by
    rw [dist_eq_norm]
    dsimp only [p]
    rw [add_sub_cancel_left, norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hh]
  have hf' : DifferentiableOn ℂ (fun z => f (p z)) (Metric.closedBall 0 8) := by
    refine hf.comp (by fun_prop) ?_
    intro z hz
    have hzn : ‖z‖ ≤ 8 := by simpa only [Metric.mem_closedBall, dist_zero_right] using hz
    rw [Metric.mem_closedBall, hdist]
    exact (mul_le_mul_of_nonneg_left hzn hh.le).trans_eq (mul_comm _ _)
  have hM' (z : ℂ) (hz : z ∈ Metric.sphere 0 8) : ‖f (p z)‖ ≤ M := by
    have hzn : ‖z‖ = 8 := by simpa only [Metric.mem_sphere, dist_zero_right] using hz
    exact hM _ (by rw [Metric.mem_sphere, hdist, hzn, mul_comm])
  have he := error_25_unit hf' hM'
  have hchange :=
    intervalIntegral.smul_integral_comp_add_mul (a := (-1:ℝ)) (b := 1)
      (fun u : ℝ => f (u:ℂ)) h c
  have hcNorm : (h:ℂ)*(∫ u in (-1:ℝ)..1, f (p (u:ℂ))) =
      ∫ u in (c-h)..(c+h), f (u:ℂ) := by
    simpa only [mul_neg, mul_one, ← sub_eq_add_neg, Complex.real_smul, Complex.ofReal_add,
      Complex.ofReal_mul, p] using hchange
  rw [← hcNorm]
  simp only [Complex.ofReal_add, Complex.ofReal_mul, p] at he ⊢
  rw [← mul_sub, norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hh]
  exact mul_le_mul_of_nonneg_left he hh.le

#print axioms rule_certified
#print axioms error_25_unit
#print axioms error_25_panel

