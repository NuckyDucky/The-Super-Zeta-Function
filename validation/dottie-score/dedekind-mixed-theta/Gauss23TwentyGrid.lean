def gauss23TwentyCover (k : ℕ) : Gauss23CellCover :=
  twentyCovers.getD k (.nonvanishing (.leaf false false))

theorem gauss23_twentySegment_of_checks (start len m : ℕ) (hEnd : start + len ≤ 168)
    (value : ℕ → ComplexBox)
    (hValue : ∀ j ≤ 36, ComplexBox.Contains (value j)
      (gauss23CenteredCoeff false (m : ℝ) j))
    (hAnchor : ∀ j : Fin len, gauss23TwentyAnchor (start + j.val) = m)
    (hCheck : ∀ j : Fin len, (gauss23TwentyCover (start + j.val)).check value (start + j.val) = true)
    (j : Fin len) : Discriminant23TwentyCellCondition (start + j.val) := by
  apply Gauss23CellCover.sound value (show start + j.val < 168 by have := j.isLt; omega) _ _ (hCheck j)
  rw [hAnchor j]
  exact hValue

#print axioms gauss23_twentySegment_of_checks

end FieldTarget
