set_option maxHeartbeats 0 in
private theorem weights_eq (j : Fin 16) :
    ∀ i : Fin 24, gauss23TableWeight weights j i =
      gauss23IntegerWeightBox (gauss23CachedUnitPhase j i) 24 j i := by
  fin_cases j <;> decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 0 in
private theorem values_eq (k : Fin 37) :
    gauss23RightValue 24 k.val = gauss23SharedValueCoefficient (gauss23TableWeight weights) k.val := by
  fin_cases k <;> decide +kernel

theorem gauss23_right_values_at_24_contain (k : ℕ) (hk : k ≤ 36) :
    ComplexBox.Contains (gauss23RightValue 24 k) (gauss23CenteredCoeff false 24 k) :=
  gauss23_tableValue_contains 24 _ _ weights_eq values_eq k hk

