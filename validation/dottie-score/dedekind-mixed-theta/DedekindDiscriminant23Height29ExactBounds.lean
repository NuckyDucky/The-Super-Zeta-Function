private def height29ResidualCoeff (k : ℕ) : GaussianInt :=
  gaussianPolynomialProductCoeff height29WeightList height29ModelList k +
    ([⟨0, (height29Den : ℤ)⟩] : List GaussianInt).getD k 0

set_option maxHeartbeats 5000000 in
private theorem height29_residual_coefficients_by_block (a : Fin 21) :
    ∀ b : Fin 8, height29ResidualCoeff (a.val * 8 + b.val) =
      height29ResidualNumerators.getD (a.val * 8 + b.val) 0 := by
  fin_cases a <;> decide +kernel

private theorem height29_residual_coefficients :
    height29ResidualList = height29ResidualNumerators := by
  have hWeight : height29WeightList ≠ [] := by
    intro h
    have hLength := congrArg List.length h
    simp only [height29WeightList, List.length_ofFn, List.length_nil] at hLength
    omega
  have hModel : height29ModelList ≠ [] := by
    intro h
    have hLength := congrArg List.length h
    simp only [height29ModelList, List.length_ofFn, List.length_nil] at hLength
    omega
  have hLeft : height29ResidualList.length = 161 := by
    rw [height29ResidualList, gaussianPolynomialAdd_length, gaussianPolynomialMul_length hWeight hModel]
    simpa only [height29WeightList, height29ModelList, List.length_ofFn,
      List.length_cons, List.length_nil] using (by decide : max (49 + 113 - 1) 1 = 161)
  have hRight : height29ResidualNumerators.length = 161 := rfl
  refine List.ext_getElem (hLeft.trans hRight.symm) fun k h₁ h₂ ↦ ?_
  have hIndex : k < 161 := hLeft ▸ h₁
  let a : Fin 21 := ⟨k / 8, by omega⟩
  let b : Fin 8 := ⟨k % 8, by omega⟩
  have hSum : a.val * 8 + b.val = k := by dsimp [a, b]; omega
  have hCoeff := height29_residual_coefficients_by_block a b
  rw [hSum] at hCoeff
  calc
    height29ResidualList[k]'h₁ = height29ResidualList.getD k 0 := by
      exact (congrArg (fun x : Option GaussianInt ↦ x.getD 0)
        (List.getElem?_eq_getElem h₁)).symm
    _ = height29ResidualNumerators.getD k 0 := by
      rw [height29ResidualList, gaussianPolynomialAdd_getD, gaussianPolynomialMul_getD]
      exact hCoeff
    _ = height29ResidualNumerators[k]'h₂ := by
      exact congrArg (fun x : Option GaussianInt ↦ x.getD 0) (List.getElem?_eq_getElem h₂)

private theorem height29Weight_eval (z : ℂ) :
    dottieRationalWeight c29 discriminant23Height29Weight z =
      gaussianPolynomialEval height29WeightList (z - c29) := by
  have h := dottieRationalWeight_eq_gaussianPolynomialEval height29WeightCoeff 1 c29 z
  have hCoeff : (fun k : Fin 49 ↦ (((height29WeightCoeff k).re : ℚ),
      ((height29WeightCoeff k).im : ℚ))) = discriminant23Height29Weight := rfl
  simpa only [height29WeightList, Nat.cast_one, div_one, hCoeff] using h

private theorem height29Model_eval (z : ℂ) :
    dottieRationalWeight c29 discriminant23Height29Model z =
      gaussianPolynomialEval height29ModelList (z - c29) / (height29Den : ℂ) :=
  dottieRationalWeight_eq_gaussianPolynomialEval height29ModelCoeff height29Den c29 z

private theorem height29Residual_eval (z : ℂ) :
    dottieRationalWeight c29 discriminant23Height29Weight z *
      dottieRationalWeight c29 discriminant23Height29Model z + I =
        gaussianPolynomialEval height29ResidualList (z - c29) / (height29Den : ℂ) := by
  have hDen : (height29Den : ℂ) ≠ 0 := by norm_num [height29Den]
  rw [height29Weight_eval, height29Model_eval, height29ResidualList,
    gaussianPolynomialEval_add, gaussianPolynomialEval_mul]
  have hConstant : gaussianPolynomialEval [⟨0, (height29Den : ℤ)⟩] (z - c29) =
      (height29Den : ℂ) * I := by
    simp [gaussianPolynomialEval, GaussianInt.toComplex_def]
  rw [hConstant, ← mul_div_assoc]
  field_simp [hDen]

set_option maxHeartbeats 5000000 in
private theorem height29_model_rational_norm :
    gaussianPolynomialNormBound height29ModelList (63 / 256) / (height29Den : ℚ) +
      2 / 10 ^ 68 ≤ (4 : ℚ) / 10 ^ 56 := by
  decide +kernel

set_option maxHeartbeats 5000000 in
private theorem height29_residual_rational_norm :
    gaussianPolynomialNormBound height29ResidualList (63 / 256) / (height29Den : ℚ) ≤
      (29 : ℚ) / 50 := by
  rw [height29_residual_coefficients]
  decide +kernel

theorem discriminant23_height29_model_norm_budget {z : ℂ} (hz : z ∈ closedBall c29 ρ29) :
    ‖dottieRationalWeight c29 discriminant23Height29Model z‖ +
      2 / 10 ^ 68 ≤ (4 : ℝ) / 10 ^ 56 := by
  have hDist := mem_closedBall.mp hz
  rw [dist_eq_norm, discriminant23_height29_dottie_geometry.2.2] at hDist
  have hNorm := norm_gaussianPolynomialEval_le height29ModelList
    (z := z - c29) (r := 63 / 256) (by simpa only [Rat.cast_div, Rat.cast_ofNat] using hDist)
  have h := (Rat.cast_le (K := ℝ)).mpr height29_model_rational_norm
  push_cast at h
  rw [height29Model_eval, norm_div, Complex.norm_natCast]
  exact (add_le_add (div_le_div_of_nonneg_right hNorm (Nat.cast_nonneg _)) le_rfl).trans h

theorem discriminant23_height29_residual_bound {z : ℂ} (hz : z ∈ closedBall c29 ρ29) :
    ‖dottieRationalWeight c29 discriminant23Height29Weight z *
      dottieRationalWeight c29 discriminant23Height29Model z + I‖ ≤ 29 / 50 := by
  have hDist := mem_closedBall.mp hz
  rw [dist_eq_norm, discriminant23_height29_dottie_geometry.2.2] at hDist
  have hNorm := norm_gaussianPolynomialEval_le height29ResidualList
    (z := z - c29) (r := 63 / 256) (by simpa only [Rat.cast_div, Rat.cast_ofNat] using hDist)
  have h := (Rat.cast_le (K := ℝ)).mpr height29_residual_rational_norm
  push_cast at h
  rw [height29Residual_eval, norm_div, Complex.norm_natCast]
  exact (div_le_div_of_nonneg_right hNorm (Nat.cast_nonneg _)).trans h

/-- The direct comparison holds on the entire disk of the model enclosure. -/
theorem discriminant23_height29_weighted_reading_norm_le
    (hE : ∀ z ∈ closedBall c29 ρ29,
      ‖8 * discriminant23CompletedClassProduct z -
        dottieRationalWeight c29 discriminant23Height29Model z‖ ≤ 2 / 10 ^ 68)
    {w : ℂ} (hw : w ∈ closedBall c29 ρ29) :
    ‖dottieRationalWeight c29 discriminant23Height29Weight w *
      (8 * discriminant23CompletedClassProduct w) + I‖ ≤ 3 / 5 := by
  have hWeight := (norm_dottieRationalWeight_le discriminant23Height29Weight hw).trans
    discriminant23_height29_weight_bound
  exact (dottie_weighted_reading_norm_le hWeight
    (discriminant23_height29_residual_bound hw) (hE w hw)).trans (by norm_num)

private theorem height29_outer_strip {w : ℂ} (hw : w ∈ closedBall c29 ρ29) :
    0 < w.re ∧ w.re < 1 := by
  obtain ⟨_, hlo, hhi⟩ := dottieWeightOuterRadius_geometry T29 0
  have hDist : ‖w - c29‖ ≤ ρ29 := (dist_eq_norm w c29) ▸ mem_closedBall.mp hw
  have hRe := abs_le.mp ((abs_re_le_norm (w - c29)).trans hDist)
  rw [sub_re] at hRe
  exact ⟨by linarith only [hlo, hRe.1], by linarith only [hhi, hRe.2]⟩

/-- The height-29 exclusion with only the uniform analytic model error as input. -/
theorem discriminant23_height29_dottie_ne_zero_of_model_error
    (hE : ∀ z ∈ closedBall c29 ρ29,
      ‖8 * discriminant23CompletedClassProduct z -
        dottieRationalWeight c29 discriminant23Height29Model z‖ ≤ 2 / 10 ^ 68)
    {w : ℂ} (hw : w ∈ closedBall c29 ρ29) : mixedThetaContinuation L23 w ≠ 0 := by
  obtain ⟨h₀, h₁⟩ := height29_outer_strip hw
  intro hZero
  have hReading := (mixedThetaCompletedReading_zero_iff L23 w h₀ h₁).mpr hZero
  have hProduct := (discriminant23_completedReading_eq_classProduct w h₀ h₁).symm.trans hReading
  have hGap := discriminant23_height29_weighted_reading_norm_le hE hw
  rw [hProduct, mul_zero, zero_add, norm_I] at hGap
  norm_num at hGap

/-- The base Dedekind and completed Hecke factors are nonzero at the same input. -/
theorem discriminant23_height29_factors_ne_zero_of_model_error
    (hE : ∀ z ∈ closedBall c29 ρ29,
      ‖8 * discriminant23CompletedClassProduct z -
        dottieRationalWeight c29 discriminant23Height29Model z‖ ≤ 2 / 10 ^ 68)
    {w : ℂ} (hw : w ∈ closedBall c29 ρ29) :
    mixedThetaContinuation F23 w ≠ 0 ∧ discriminant23CharacterFold w ≠ 0 := by
  obtain ⟨h₀, h₁⟩ := height29_outer_strip hw
  have hZero := (discriminant23_dedekind_zero_iff_base_or_character w h₀ h₁).mpr
  have hNe := discriminant23_height29_dottie_ne_zero_of_model_error hE hw
  exact ⟨fun h ↦ hNe (hZero (Or.inl h)), fun h ↦ hNe (hZero (Or.inr h))⟩

