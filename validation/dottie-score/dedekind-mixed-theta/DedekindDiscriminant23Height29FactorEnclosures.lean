open Complex Metric SuperZeta.StirlingCorrection

noncomputable section

set_option exponentiation.threshold 512

def discriminant23Height29ReadingPoint (j : ℕ) : ℂ :=
  dottieScaledRightCenter (29 + 1 / 512 : ℝ) 0 +
    ((1 / 2 : ℝ) : ℂ) * discriminant23Height29Root ^ j

def discriminant23Height29BaseFactor (w : ℂ) : ℂ :=
  discriminant23TotalClassReading w - (3 / 2 : ℂ) / (w * (1 - w))

def height29FactorDenominator : ℕ := 2 ^ 128

