def height29BaseNumerator (j : ℕ) : GaussianInt := (height29FactorData[j]!).1
def height29HeckeNumerator (j : ℕ) : GaussianInt := (height29FactorData[j]!).2

def discriminant23Height29BaseApprox (j : ℕ) : ℂ :=
  gaussianScaled (height29BaseNumerator j) height29FactorDenominator

def discriminant23Height29HeckeApprox (j : ℕ) : ℂ :=
  gaussianScaled (height29HeckeNumerator j) height29FactorDenominator

set_option maxHeartbeats 5000000 in
private theorem height29_base_approx_size_checked :
    ∀ j : Fin 128, gaussianNormCeiling (height29BaseNumerator j) * 10 ^ 18 ≤
      height29FactorDenominator * 1 := by
  decide +kernel

set_option maxHeartbeats 5000000 in
private theorem height29_hecke_approx_size_checked :
    ∀ j : Fin 128, gaussianNormCeiling (height29HeckeNumerator j) * 10 ^ 19 ≤
      height29FactorDenominator * 3 := by
  decide +kernel

private theorem height29_base_approx_size {j : ℕ} (hj : j < 128) :
    ‖discriminant23Height29BaseApprox j‖ ≤ 1 / 10 ^ 18 := by
  simpa only [discriminant23Height29BaseApprox, Nat.cast_one, Nat.cast_pow, Nat.cast_ofNat] using
    norm_gaussianScaled_le_of_nat_bound (by norm_num [height29FactorDenominator]) (by norm_num)
      (height29_base_approx_size_checked ⟨j, hj⟩)

private theorem height29_hecke_approx_size {j : ℕ} (hj : j < 128) :
    ‖discriminant23Height29HeckeApprox j‖ ≤ 3 / 10 ^ 19 := by
  simpa only [discriminant23Height29HeckeApprox, Nat.cast_pow, Nat.cast_ofNat] using
    norm_gaussianScaled_le_of_nat_bound (by norm_num [height29FactorDenominator]) (by norm_num)
      (height29_hecke_approx_size_checked ⟨j, hj⟩)

private def height29_factorProductResidual (j : ℕ) : GaussianInt :=
  ((2 ^ 96 : ℕ) : GaussianInt) * height29SampleNumerator j -
    8 * height29BaseNumerator j * height29HeckeNumerator j ^ 2

private theorem height29_factor_product_residual_eq (j : ℕ) :
    discriminant23Height29Samples j -
      8 * discriminant23Height29BaseApprox j * discriminant23Height29HeckeApprox j ^ 2 =
    gaussianScaled (height29_factorProductResidual j) (height29FactorDenominator ^ 3) := by
  simp only [discriminant23Height29Samples, discriminant23Height29BaseApprox,
    discriminant23Height29HeckeApprox, height29_factorProductResidual, gaussianScaled,
    height29FactorDenominator, height29SampleDenominator, map_sub, map_mul, map_pow, map_ofNat,
    Nat.cast_pow, Nat.cast_ofNat]
  ring

set_option maxHeartbeats 5000000 in
private theorem height29_factor_product_rounding_checked :
    ∀ j : Fin 128, gaussianNormCeiling (height29_factorProductResidual j) * 10 ^ 61 ≤
      height29FactorDenominator ^ 3 * 1 := by
  decide +kernel

private theorem height29_factor_product_rounding {j : ℕ} (hj : j < 128) :
    ‖discriminant23Height29Samples j -
      8 * discriminant23Height29BaseApprox j * discriminant23Height29HeckeApprox j ^ 2‖ ≤
        1 / 10 ^ 61 := by
  rw [height29_factor_product_residual_eq]
  simpa only [Nat.cast_one, Nat.cast_pow, Nat.cast_ofNat] using
    norm_gaussianScaled_le_of_nat_bound (by norm_num [height29FactorDenominator]) (by norm_num)
      (height29_factor_product_rounding_checked ⟨j, hj⟩)

private theorem height29_factor_product_perturbation {A B a b : ℂ}
    (ha : ‖a‖ ≤ 1 / 10 ^ 18) (hb : ‖b‖ ≤ 3 / 10 ^ 19)
    (hA : ‖A - a‖ ≤ 1 / 10 ^ 25) (hB : ‖B - b‖ ≤ 1 / 10 ^ 25) :
    ‖8 * A * B ^ 2 - 8 * a * b ^ 2‖ ≤ 9 / 10 ^ 61 := by
  have hnB := (norm_le_norm_sub_add B b).trans (add_le_add hB hb)
  have hPlus := (norm_add_le B b).trans (add_le_add hnB hb)
  have hFirst : ‖(A - a) * B ^ 2‖ ≤
      (1 / 10 ^ 25 : ℝ) * (1 / 10 ^ 25 + 3 / 10 ^ 19) ^ 2 := by
    rw [norm_mul, norm_pow]
    exact mul_le_mul hA (pow_le_pow_left₀ (norm_nonneg _) hnB 2) (by positivity) (by positivity)
  have hSecond : ‖a * ((B - b) * (B + b))‖ ≤
      (1 / 10 ^ 18 : ℝ) * ((1 / 10 ^ 25) * ((1 / 10 ^ 25 + 3 / 10 ^ 19) + 3 / 10 ^ 19)) := by
    rw [norm_mul, norm_mul]
    exact mul_le_mul ha (mul_le_mul hB hPlus (norm_nonneg _) (by positivity))
      (by positivity) (by positivity)
  have hEq : 8 * A * B ^ 2 - 8 * a * b ^ 2 =
      8 * ((A - a) * B ^ 2 + a * ((B - b) * (B + b))) := by ring
  rw [hEq, norm_mul, show ‖(8 : ℂ)‖ = 8 by norm_num]
  refine (mul_le_mul_of_nonneg_left ((norm_add_le _ _).trans (add_le_add hFirst hSecond))
    (by norm_num)).trans ?_
  norm_num

/-- Enclosing each factor to the stated tolerance suffices for the sample premise. -/
theorem discriminant23_height29_sample_error_of_factor_enclosures
    (hBase : ∀ j < 128, ‖discriminant23Height29BaseFactor (discriminant23Height29ReadingPoint j) -
      discriminant23Height29BaseApprox j‖ ≤ 1 / 10 ^ 25)
    (hHecke : ∀ j < 128, ‖discriminant23CharacterClassReading (discriminant23Height29ReadingPoint j) -
      discriminant23Height29HeckeApprox j‖ ≤ 1 / 10 ^ 25) :
    ∀ j < 128, ‖discriminant23Height29Samples j -
      8 * discriminant23CompletedClassProduct (discriminant23Height29ReadingPoint j)‖ ≤
        1 / 10 ^ 60 := by
  intro j hj
  let a := discriminant23Height29BaseApprox j
  let b := discriminant23Height29HeckeApprox j
  let w := discriminant23Height29ReadingPoint j
  have hPerturb := height29_factor_product_perturbation
    (height29_base_approx_size hj) (height29_hecke_approx_size hj) (hBase j hj) (hHecke j hj)
  have hPerturb' : ‖8 * a * b ^ 2 - 8 * discriminant23CompletedClassProduct w‖ ≤ 9 / 10 ^ 61 := by
    rw [norm_sub_rev, discriminant23CompletedClassProduct, ← mul_assoc]
    exact hPerturb
  exact (norm_sub_le_norm_sub_add_norm_sub _ (8 * a * b ^ 2) _).trans
    ((add_le_add (height29_factor_product_rounding hj) hPerturb').trans (by norm_num))

#check @discriminant23_height29_sample_error_of_factor_enclosures
#print axioms discriminant23_height29_sample_error_of_factor_enclosures

end
