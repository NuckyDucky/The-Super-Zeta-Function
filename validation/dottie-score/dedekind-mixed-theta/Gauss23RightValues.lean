def gauss23RightValue (m k : ℕ) : ComplexBox :=
  if m ≤ 20 then gauss23TwentyValue m k
  else (rightValues.getD (m - 21) #[]).getD k ComplexBox.zero

theorem gauss23_right_values_at_20_contain (k : ℕ) (hk : k ≤ 36) :
    ComplexBox.Contains (gauss23RightValue 20 k) (gauss23CenteredCoeff false 20 k) :=
  gauss23_values_at_20_contain k hk

