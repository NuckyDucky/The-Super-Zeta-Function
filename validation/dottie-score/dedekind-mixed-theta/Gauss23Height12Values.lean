private theorem values_eq (k : Fin 37) :
    gauss23TwentyValue 12 k.val = gauss23SharedValueCoefficient (gauss23TableWeight weights) k.val := by
  fin_cases k <;> decide +kernel

theorem gauss23_values_at_12_contain (k : ℕ) (hk : k ≤ 36) :
    ComplexBox.Contains (gauss23TwentyValue 12 k) (gauss23CenteredCoeff false 12 k) :=
  gauss23_tableValue_contains 12 _ _ weights_eq values_eq k hk

