private theorem sin_pi_div_64_enclosure :
    (16696864359439569162511425913059001619 : ℝ) / 2 ^ 128 ≤ Real.sin (Real.pi / 64) ∧
    Real.sin (Real.pi / 64) ≤ (16696864359439569162511425913059001625 : ℝ) / 2 ^ 128 := by
  refine sin_half_enclosure (x := Real.pi / 64) (a := (338643814315582355912937410983851649519 : ℝ) / 2 ^ 128) (b := (338643814315582355912937410983851649520 : ℝ) / 2 ^ 128)
    (by positivity) (by linarith [Real.pi_pos]) ?_ (by norm_num) (by norm_num) (by norm_num)
  rw [show 2 * (Real.pi / 64) = Real.pi / 32 by ring]
  exact cos_pi_div_32_enclosure

private theorem contourRoot128_inverse_coordinates :
    (contourRoot128⁻¹).re = Real.cos (Real.pi / 64) ∧
    (contourRoot128⁻¹).im = -Real.sin (Real.pi / 64) := by
  have hArg : -(2 * (Real.pi : ℂ) * I / 128) = ((-(Real.pi / 64) : ℝ) : ℂ) * I := by
    push_cast
    ring
  rw [contourRoot128, ← Complex.exp_neg, hArg]
  constructor <;> simp [Complex.exp_re, Complex.exp_im, Complex.mul_re, Complex.mul_im]

private theorem contourRoot128_inverse_near_generator :
    ‖contourRoot128⁻¹ - gaussianScaled contourRoot128Generator contourRoot128Scale‖ ≤
      (2 : ℝ) / contourRoot128Scale := by
  have hGRe : (gaussianScaled contourRoot128Generator contourRoot128Scale).re =
      (79132728722732187244728061659 : ℝ) / 2 ^ 96 := by
    norm_num [gaussianScaled, contourRoot128Generator, contourRoot128Scale,
      GaussianInt.toComplex_def, Complex.div_re, Complex.normSq_apply]
  have hGIm : (gaussianScaled contourRoot128Generator contourRoot128Scale).im =
      (-3887541675809670510355249493 : ℝ) / 2 ^ 96 := by
    norm_num [gaussianScaled, contourRoot128Generator, contourRoot128Scale,
      GaussianInt.toComplex_def, Complex.div_im, Complex.normSq_apply]
  have hRe : |(contourRoot128⁻¹ - gaussianScaled contourRoot128Generator contourRoot128Scale).re| ≤
      (1 : ℝ) / 2 ^ 96 := by
    rw [Complex.sub_re, contourRoot128_inverse_coordinates.1, hGRe]
    obtain ⟨hLo, hHi⟩ := cos_pi_div_64_enclosure
    refine abs_le.mpr ⟨?_, ?_⟩
    · linarith only [hLo]
    · linarith only [hHi]
  have hIm : |(contourRoot128⁻¹ - gaussianScaled contourRoot128Generator contourRoot128Scale).im| ≤
      (1 : ℝ) / 2 ^ 96 := by
    rw [Complex.sub_im, contourRoot128_inverse_coordinates.2, hGIm]
    obtain ⟨hLo, hHi⟩ := sin_pi_div_64_enclosure
    refine abs_le.mpr ⟨?_, ?_⟩
    · linarith only [hHi]
    · linarith only [hLo]
  refine (Complex.norm_le_abs_re_add_abs_im _).trans ((add_le_add hRe hIm).trans ?_)
  norm_num [contourRoot128Scale]

