    change gaussianScaled (contourRoot128PhaseNumerator 0) contourRoot128Scale = 1
    rw [hNum]
    norm_num [gaussianScaled, contourRoot128Scale, GaussianInt.toComplex_def]
  have hSize (k : ℕ) (hk : k < 128) : ‖q k‖ ≤ 2 := by
    simpa [q] using norm_gaussianScaled_le_of_nat_bound
