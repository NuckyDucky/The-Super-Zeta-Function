/-- The Gaussian numerator of the phase at the given index. -/
def contourRoot128PhaseNumerator (j : ℕ) : GaussianInt := contourRoot128PhaseData[j]!

set_option maxHeartbeats 5000000 in
private theorem contourRoot128_size_checked :
    ∀ j : Fin 128, gaussianNormCeiling (contourRoot128PhaseNumerator j) * 1 ≤
      contourRoot128Scale * 2 := by
  decide +kernel

set_option maxHeartbeats 5000000 in
private theorem contourRoot128_step_checked :
    ∀ j : Fin 127, gaussianNormCeiling
      (contourRoot128Generator * contourRoot128PhaseNumerator j -
        (contourRoot128Scale : GaussianInt) * contourRoot128PhaseNumerator (j.val + 1)) *
      contourRoot128Scale ≤ (contourRoot128Scale * contourRoot128Scale) * 2 := by
  decide +kernel

/-- The exact inverse phases are uniformly enclosed by the dyadic table. -/
theorem contourRoot128_phase_error (j : ℕ) (hj : j < 128) :
    ‖(contourRoot128⁻¹) ^ j -
      gaussianScaled (contourRoot128PhaseNumerator j) contourRoot128Scale‖ ≤ 1 / 10 ^ 24 := by
  let q := fun n ↦ gaussianScaled (contourRoot128PhaseNumerator n) contourRoot128Scale
  let g := gaussianScaled contourRoot128Generator contourRoot128Scale
  have hUnit : ‖contourRoot128⁻¹‖ = 1 := by
