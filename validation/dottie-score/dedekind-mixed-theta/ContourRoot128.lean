import ContourGaussianDFT

namespace FieldTarget

open Complex Set

noncomputable section

set_option exponentiation.threshold 512

/-- The exact root used for the 128 equally spaced contour readings. -/
def contourRoot128 : ℂ := Complex.exp (2 * (Real.pi : ℂ) * I / 128)

theorem contourRoot128_isPrimitive : IsPrimitiveRoot contourRoot128 128 :=
  Complex.isPrimitiveRoot_exp 128 (by norm_num)

def contourRoot128Scale : ℕ := 2 ^ 96

private def contourRoot128Generator : GaussianInt := ⟨79132728722732187244728061659, -3887541675809670510355249493⟩

private theorem le_of_nonneg_squares {a b : ℝ} (hb : 0 ≤ b) (h : a^2 ≤ b^2) : a ≤ b := by
  by_contra! hab
  have hProd := mul_pos (sub_pos.mpr hab) (add_pos_of_pos_of_nonneg (hb.trans_lt hab) hb)
  nlinarith only [h, hProd]

private theorem cos_half_enclosure {x a b lo hi : ℝ}
    (hx : 0 ≤ x) (hx' : x ≤ Real.pi / 2)
    (hDouble : a ≤ Real.cos (2 * x) ∧ Real.cos (2 * x) ≤ b)
    (hhi : 0 ≤ hi)
    (hL : lo^2 ≤ (1 + a) / 2) (hU : (1 + b) / 2 ≤ hi^2) :
    lo ≤ Real.cos x ∧ Real.cos x ≤ hi := by
  have hCos₀ := Real.cos_nonneg_of_mem_Icc
    (show x ∈ Icc (-(Real.pi / 2)) (Real.pi / 2) from
      ⟨by linarith [Real.pi_pos], hx'⟩)
  have hIdentity := Real.cos_two_mul x
  exact ⟨le_of_nonneg_squares hCos₀ (by linarith only [hL, hIdentity, hDouble.1]),
    le_of_nonneg_squares hhi (by linarith only [hU, hIdentity, hDouble.2])⟩

private theorem sin_half_enclosure {x a b lo hi : ℝ}
    (hx : 0 ≤ x) (hx' : x ≤ Real.pi / 2)
    (hDouble : a ≤ Real.cos (2 * x) ∧ Real.cos (2 * x) ≤ b)
    (hhi : 0 ≤ hi) (hL : lo^2 ≤ (1 - b) / 2) (hU : (1 - a) / 2 ≤ hi^2) :
    lo ≤ Real.sin x ∧ Real.sin x ≤ hi := by
  have hSin₀ := Real.sin_nonneg_of_mem_Icc
    (show x ∈ Icc 0 Real.pi from ⟨hx, by linarith [Real.pi_pos]⟩)
  have hIdentity := Real.cos_two_mul_eq_one_sub x
  exact ⟨le_of_nonneg_squares hSin₀ (by linarith only [hL, hIdentity, hDouble.2]),
    le_of_nonneg_squares hhi (by linarith only [hU, hIdentity, hDouble.1])⟩

private theorem cos_pi_div_4_enclosure :
    (240615969168004511545033772477625056927 : ℝ) / 2 ^ 128 ≤ Real.cos (Real.pi / 4) ∧
    Real.cos (Real.pi / 4) ≤ (240615969168004511545033772477625056928 : ℝ) / 2 ^ 128 := by
  refine cos_half_enclosure (x := Real.pi / 4) (a := (0 : ℝ)) (b := (0 : ℝ))
    (by positivity) (by linarith [Real.pi_pos]) ?_
    (by norm_num) (by norm_num) (by norm_num)
  rw [show 2 * (Real.pi / 4) = Real.pi / 2 by ring]
  simp [Real.cos_pi_div_two]

private theorem cos_pi_div_8_enclosure :
    (314379914072750776175968446001973125504 : ℝ) / 2 ^ 128 ≤ Real.cos (Real.pi / 8) ∧
    Real.cos (Real.pi / 8) ≤ (314379914072750776175968446001973125506 : ℝ) / 2 ^ 128 := by
  refine cos_half_enclosure (x := Real.pi / 8) (a := (240615969168004511545033772477625056927 : ℝ) / 2 ^ 128) (b := (240615969168004511545033772477625056928 : ℝ) / 2 ^ 128)
    (by positivity) (by linarith [Real.pi_pos]) ?_
    (by norm_num) (by norm_num) (by norm_num)
  rw [show 2 * (Real.pi / 8) = Real.pi / 4 by ring]
  exact cos_pi_div_4_enclosure

private theorem cos_pi_div_16_enclosure :
    (333743936656827580393945988193699131950 : ℝ) / 2 ^ 128 ≤ Real.cos (Real.pi / 16) ∧
    Real.cos (Real.pi / 16) ≤ (333743936656827580393945988193699131952 : ℝ) / 2 ^ 128 := by
  refine cos_half_enclosure (x := Real.pi / 16) (a := (314379914072750776175968446001973125504 : ℝ) / 2 ^ 128) (b := (314379914072750776175968446001973125506 : ℝ) / 2 ^ 128)
    (by positivity) (by linarith [Real.pi_pos]) ?_
    (by norm_num) (by norm_num) (by norm_num)
  rw [show 2 * (Real.pi / 16) = Real.pi / 8 by ring]
  exact cos_pi_div_8_enclosure

private theorem cos_pi_div_32_enclosure :
    (338643814315582355912937410983851649519 : ℝ) / 2 ^ 128 ≤ Real.cos (Real.pi / 32) ∧
    Real.cos (Real.pi / 32) ≤ (338643814315582355912937410983851649520 : ℝ) / 2 ^ 128 := by
  refine cos_half_enclosure (x := Real.pi / 32) (a := (333743936656827580393945988193699131950 : ℝ) / 2 ^ 128) (b := (333743936656827580393945988193699131952 : ℝ) / 2 ^ 128)
    (by positivity) (by linarith [Real.pi_pos]) ?_
    (by norm_num) (by norm_num) (by norm_num)
  rw [show 2 * (Real.pi / 32) = Real.pi / 16 by ring]
  exact cos_pi_div_16_enclosure

private theorem cos_pi_div_64_enclosure :
    (339872481907374595982655373237523399997 : ℝ) / 2 ^ 128 ≤ Real.cos (Real.pi / 64) ∧
    Real.cos (Real.pi / 64) ≤ (339872481907374595982655373237523399998 : ℝ) / 2 ^ 128 := by
  refine cos_half_enclosure (x := Real.pi / 64) (a := (338643814315582355912937410983851649519 : ℝ) / 2 ^ 128) (b := (338643814315582355912937410983851649520 : ℝ) / 2 ^ 128)
    (by positivity) (by linarith [Real.pi_pos]) ?_
