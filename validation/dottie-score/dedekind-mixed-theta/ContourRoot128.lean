    exact norm_gaussianScaled_le_of_nat_bound (Nat.mul_pos hd hd) hd (contourRoot128_step_checked ⟨k, hk'⟩)
  have h := norm_unitPowers_sub_le hUnit hZero contourRoot128_inverse_near_generator hSize hStep j hj
  refine h.trans ?_
  have hj' : (j : ℝ) ≤ 128 := by exact_mod_cast hj.le
  calc
    _ ≤ (128 : ℝ) * (2 * ((2 : ℝ) / contourRoot128Scale) + (2 : ℝ) / contourRoot128Scale) :=
      mul_le_mul_of_nonneg_right hj' (by positivity)
    _ ≤ _ := by norm_num [contourRoot128Scale]

