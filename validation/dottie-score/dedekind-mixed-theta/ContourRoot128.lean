  have hd : 0 < contourRoot128Scale := by norm_num [contourRoot128Scale]
  have hStep (k : ℕ) (hk : k + 1 < 128) : ‖g * q k - q (k + 1)‖ ≤ (2 : ℝ) / contourRoot128Scale := by
    dsimp [g, q]
