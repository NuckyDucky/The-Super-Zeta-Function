private theorem values_eq (k : Fin 37) :
    gauss23RightValue 27 k.val = gauss23SharedValueCoefficient (gauss23TableWeight weights) k.val := by
  fin_cases k <;> decide +kernel

theorem gauss23_right_values_at_27_contain (k : ℕ) (hk : k ≤ 36) :
    ComplexBox.Contains (gauss23RightValue 27 k) (gauss23CenteredCoeff false 27 k) :=
  gauss23_tableValue_contains 27 _ _ weights_eq values_eq k hk

