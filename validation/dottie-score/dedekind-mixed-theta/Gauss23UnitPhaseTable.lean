def gauss23CachedUnitPhase (j : Fin 16) (i : Fin 24) : ComplexBox :=
  (phaseRows.getD j.val #[]).getD i.val ComplexBox.zero

set_option maxRecDepth 16384 in
set_option maxHeartbeats 0 in
theorem gauss23_cachedUnitPhase_eq (j : Fin 16) :
    ∀ i : Fin 24, gauss23CachedUnitPhase j i = gauss23UnitPhaseBox j i := by
  fin_cases j <;> decide +kernel

theorem gauss23_cachedUnitPhase_contains (j : Fin 16) (i : Fin 24) :
    ComplexBox.Contains (gauss23CachedUnitPhase j i)
      (Complex.exp ((gauss23LogNode j i : ℂ) * Complex.I)) := by
  rw [gauss23_cachedUnitPhase_eq]
  exact gauss23_unitPhaseBox_contains j i

#print axioms gauss23_cachedUnitPhase_eq
#print axioms gauss23_cachedUnitPhase_contains

end FieldTarget
