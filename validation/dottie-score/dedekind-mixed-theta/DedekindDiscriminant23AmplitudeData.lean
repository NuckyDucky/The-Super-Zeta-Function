private theorem amplitude_blocks (j : ℕ) (hj : j < 257) :
    discriminant23ReadingAmplitudeBox false j = storedValueBox j := by
  generalize hq : j / 16 = q
  have hqMax : q ≤ 16 := by omega
  interval_cases q
  · have hAt : 0 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock0 ⟨j % 16, by omega⟩
  · have hAt : 16 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock1 ⟨j % 16, by omega⟩
  · have hAt : 32 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock2 ⟨j % 16, by omega⟩
  · have hAt : 48 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock3 ⟨j % 16, by omega⟩
