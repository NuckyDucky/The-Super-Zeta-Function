  · have hAt : 128 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock8 ⟨j % 16, by omega⟩
  · have hAt : 144 + j % 16 = j := by omega
    simpa only [hAt] using amplitudeBlock9 ⟨j % 16, by omega⟩
  · have hAt : 160 + j % 16 = j := by omega
