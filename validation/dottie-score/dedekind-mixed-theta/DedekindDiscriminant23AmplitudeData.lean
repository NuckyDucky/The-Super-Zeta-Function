/-- The validated value amplitudes give the slope amplitudes by one
multiplication by the corresponding integration node. -/
def discriminant23StoredReadingAmplitudeBox (odd : Bool) (j : ℕ) : Box :=
  if odd then mul (storedValueBox j) (discriminant23ReadingNodeBox j) else storedValueBox j

theorem discriminant23_storedAmplitudeBox_contains (odd : Bool) {j : ℕ} (hj : j < 257) :
    Contains (discriminant23StoredReadingAmplitudeBox odd j) (discriminant23ReadingAmplitude odd j) := by
  have hEq : discriminant23StoredReadingAmplitudeBox odd j = discriminant23ReadingAmplitudeBox odd j := by
    cases odd
    · change storedValueBox j = discriminant23ReadingAmplitudeBox false j
      exact (amplitude_blocks j hj).symm
    · change mul (storedValueBox j) (discriminant23ReadingNodeBox j) =
        mul (discriminant23ReadingAmplitudeBox false j) (discriminant23ReadingNodeBox j)
      rw [amplitude_blocks j hj]
  rw [hEq]
  exact discriminant23_readingAmplitudeBox_contains odd hj

