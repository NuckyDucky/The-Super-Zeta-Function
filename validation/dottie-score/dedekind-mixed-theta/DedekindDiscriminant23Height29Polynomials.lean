def discriminant23Height29Weight (k : Fin 49) : ℚ × ℚ :=
  let a := discriminant23WeightNumerators[k.val]!
  (a.1, a.2)

def discriminant23Height29Model (k : Fin 113) : ℚ × ℚ :=
  let b := discriminant23ModelNumerators[k.val]!
  ((b.1 : ℚ) / 2 ^ 288, (b.2 : ℚ) / 2 ^ 288)

private theorem discriminant23_height29_weight_rational :
    (∑ k : Fin 49, (abs (discriminant23Height29Weight k).1 +
      abs (discriminant23Height29Weight k).2) * (63 / 256 : ℚ) ^ (k : ℕ)) ≤
      (3 : ℚ) * 10 ^ 58 := by
  decide +kernel

theorem discriminant23_height29_weight_bound :
    dottieWeightCoefficientBound discriminant23Height29Weight ρ29 ≤ 3 * 10 ^ 58 := by
  rw [discriminant23_height29_dottie_geometry.2.2, dottieWeightCoefficientBound]
  have h := (Rat.cast_le (K := ℝ)).mpr discriminant23_height29_weight_rational
  push_cast at h
  exact h

/-- The numerical replay encloses the model and the residual for the exact
rational polynomials. Lean supplies the coefficient bound and the sign budget. -/
theorem discriminant23_height29_dottie_ne_zero
    (hB : ∀ z ∈ closedBall c29 ρ29,
      ‖8 * discriminant23CompletedClassProduct z‖ ≤ 4 / 10 ^ 56)
    (hE : ∀ z ∈ closedBall c29 ρ29,
      ‖8 * discriminant23CompletedClassProduct z -
        dottieRationalWeight c29 discriminant23Height29Model z‖ ≤ 2 / 10 ^ 68)
    (hD : ∀ z ∈ closedBall c29 r29,
      ‖dottieRationalWeight c29 discriminant23Height29Weight z *
        dottieRationalWeight c29 discriminant23Height29Model z + I‖ ≤ 32 / 125)
    {w : ℂ} (hw : w ∈ closedBall c29 r29) : mixedThetaContinuation L23 w ≠ 0 :=
  discriminant23_height29_dottie_ne_zero_of_enclosures
    discriminant23Height29Weight discriminant23Height29Model hB
    discriminant23_height29_weight_bound hE hD hw

#check @discriminant23_height29_dottie_ne_zero
#print axioms discriminant23_height29_weight_bound
#print axioms discriminant23_height29_dottie_ne_zero

end FieldTarget
