import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x69408041c9001021209045124824a34d209291189089242288241281050250c8004822a48944024209204a2022083810

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 0 128 = dottiePackedPairSignBlock f 26858 0 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk0Ticks : List (ℤ × ℤ) := [
  (-3786644030633588, 2658336350141900),
  (2413598159942106, -1694417474929115),
  (-769210946493752, 540008900527588),
  (163431093605662, -114733477026256),
  (-26042650405816, 18282713587229),
  (3319905044725, -2330671917407),
  (-352683301379, 247594153197),
  (32114217407, -22545134819),
  (-2558690991, 1796277130),
  (181211533, -127215883),
  (-11550383, 8108714)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 0 128 signs = dottieSharpChunk0Ticks := by
  decide +kernel

theorem dottie_sharp_chunk0_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 0 128 =
      (dottieSharpChunk0Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 0 128 =
      (dottieSharpChunk0Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 0 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk0_moments

end QuarticModel.DottieFixedIntervals
