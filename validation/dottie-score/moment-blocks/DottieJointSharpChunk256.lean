import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x9244a248a0926a46124924248848040824a24810225200641120100804924129204122800a249a512412104410892400

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 256 128 = dottiePackedPairSignBlock f 26858 256 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk256Ticks : List (ℤ × ℤ) := [
  (-13814702622646622, -3543713156019162),
  (8805525601195558, 2258764789611203),
  (-2806331892604143, -719868983490011),
  (596254295174412, 152948300409269),
  (-95013490417500, -24372333509308),
  (12112366732669, 3106987859834),
  (-1286742082820, -330065972738),
  (117167512054, 30054891359),
  (-9335357723, -2394625618),
  (661153347, 169592859),
  (-42142069, -10809872)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 256 128 signs = dottieSharpChunk256Ticks := by
  decide +kernel

theorem dottie_sharp_chunk256_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 256 128 =
      (dottieSharpChunk256Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 256 128 =
      (dottieSharpChunk256Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 256 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk256_moments

end QuarticModel.DottieFixedIntervals
