import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x4104a44928834805124c25220944904144a202481229209450c9104825104924244a49220c49124919208a20a01148a2

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 384 128 = dottiePackedPairSignBlock f 26858 384 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk384Ticks : List (ℤ × ℤ) := [
  (9652360234616097, 5818677274251463),
  (-6152459893885216, -3708844083579296),
  (1960803462875700, 1182014724983597),
  (-416608455408423, -251140027922663),
  (66387048117306, 40019370502330),
  (-8463083455016, -5101695746846),
  (899068211820, 541972948895),
  (-81867187785, -49350763567),
  (6522816399, 3932042417),
  (-461963771, -278477430),
  (29445790, 17750244)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 384 128 signs = dottieSharpChunk384Ticks := by
  decide +kernel

theorem dottie_sharp_chunk384_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 384 128 =
      (dottieSharpChunk384Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 384 128 =
      (dottieSharpChunk384Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 384 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk384_moments

end QuarticModel.DottieFixedIntervals
