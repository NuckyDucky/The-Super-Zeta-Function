import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x5245145125129040148524120934209101144125108a452000a8008126928a04920000824104904a34221044d0494922

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 640 128 = dottiePackedPairSignBlock f 26858 640 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk640Ticks : List (ℤ × ℤ) := [
  (6591994814741089, -12412786565422890),
  (-4201862228986717, 7912131232488514),
  (1339173246344333, -2521666682640014),
  (-284538122391444, 535785085091121),
  (45342495818226, -85379738940721),
  (-5780432962169, 10884513249193),
  (614092891378, -1156330433755),
  (-55919204123, 105295087593),
  (4455494851, -8389620525),
  (-315557414, 594188175),
  (20114224, -37874613)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 640 128 signs = dottieSharpChunk640Ticks := by
  decide +kernel

theorem dottie_sharp_chunk640_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 640 128 =
      (dottieSharpChunk640Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 640 128 =
      (dottieSharpChunk640Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 640 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk640_moments

end QuarticModel.DottieFixedIntervals
