private theorem joint_ticks :
    dottieJointMomentBlock 11 37983 0 128 signs = dottieSharpBody37983From0Ticks := by
  decide +kernel

theorem dottie_sharp_body37983From0_moments (k : Fin 11) :
    (dottieSharpBody37983From0Ticks.getD k (0,0)) =
      (dottiePairRowBlock (fun n => momentWeightRealTicks n k) 37983 0 128,
       dottiePairRowBlock (fun n => momentWeightImagTicks n k) 37983 0 128) := by
  have h := dottie_joint_moment_block_getD 37983 0 128 signs k.isLt
  simpa only [joint_ticks, ← signs_eq] using h

