import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x4022220800921104d28145104910005124c45028104828a248489488069208410a0848220804129224200100d2880521

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 896 128 = dottiePackedPairSignBlock f 26858 896 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk896Ticks : List (ℤ × ℤ) := [
  (3825547919396543, 2580577728362158),
  (-2438547149420356, -1644904344791265),
  (777210523240187, 524245069447561),
  (-165141006905852, -111387588560507),
  (26316761689122, 17750088073523),
  (-3355057396400, -2262841886616),
  (356439819197, 240395680368),
  (-32458293684, -21890330571),
  (2586266127, 1744158862),
  (-183175827, -123528501),
  (11676314, 7873920)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 896 128 signs = dottieSharpChunk896Ticks := by
  decide +kernel

theorem dottie_sharp_chunk896_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 896 128 =
      (dottieSharpChunk896Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 896 128 =
      (dottieSharpChunk896Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 896 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk896_moments

end QuarticModel.DottieFixedIntervals
