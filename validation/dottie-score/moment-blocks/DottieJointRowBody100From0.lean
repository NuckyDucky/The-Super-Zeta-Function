import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x4124940118924205120e28920a45224a48a089461288308491a0840120100909124020d2512

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 100 0 100 = dottiePackedPairSignBlock f 100 0 100 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpBody100From0Ticks : List (ℤ × ℤ) := [
  (1135298988909846556, 412786391217011731),
  (-343931397508674824, -116982576024722905),
  (52089018610500457, 16531412083799514),
  (-5258692549929807, -1552600251241105),
  (398129742098524, 108972886239358),
  (-24111299763830, -6093513085700),
  (1216744801261, 282574541545),
  (-52626008572, -11167894275),
  (1991511283, 383582963),
  (-66986954, -11614977),
  (2027786, 313347)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 100 0 100 signs = dottieSharpBody100From0Ticks := by
  decide +kernel

theorem dottie_sharp_body100From0_moments (k : Fin 11) :
    (dottieSharpBody100From0Ticks.getD k (0,0)) =
      (dottiePairRowBlock (fun n => momentWeightRealTicks n k) 100 0 100,
       dottiePairRowBlock (fun n => momentWeightImagTicks n k) 100 0 100) := by
  have h := dottie_joint_moment_block_getD 100 0 100 signs k.isLt
  simpa only [joint_ticks, ← signs_eq] using h

#print axioms dottie_sharp_body100From0_moments

end QuarticModel.DottieFixedIntervals
