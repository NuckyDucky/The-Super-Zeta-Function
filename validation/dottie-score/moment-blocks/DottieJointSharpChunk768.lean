import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x4a088290000248089282049c0924022228828041220820120244224104828544904848a24920a20924046a008241a014

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 768 128 = dottiePackedPairSignBlock f 26858 768 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk768Ticks : List (ℤ × ℤ) := [
  (13585243681774733, -9144024856645026),
  (-8659620331240371, 5828631062449383),
  (2759944026004681, -1857657902029007),
  (-586422247585467, 394705931695029),
  (93450550780094, -62898868117909),
  (-11913607271513, 8018663603219),
  (1265678631083, -851882923409),
  (-115254217451, 77573081065),
  (9183289139, -6180878726),
  (-650409935, 437760819),
  (41458990, -27903967)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 768 128 signs = dottieSharpChunk768Ticks := by
  decide +kernel

theorem dottie_sharp_chunk768_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 768 128 =
      (dottieSharpChunk768Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 768 128 =
      (dottieSharpChunk768Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 768 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk768_moments

end QuarticModel.DottieFixedIntervals
