import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x251a8025025001205144a288290a0928818005144920820849028929230124a0310480020800

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 101 0 101 = dottiePackedPairSignBlock f 101 0 101 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpBody101From0Ticks : List (ℤ × ℤ) := [
  (3479971223287542662, 107091971943474749),
  (-1028844634263830385, -31838702040960404),
  (152188422416493775, 4700303795687883),
  (-15018116226304106, -459339798994101),
  (1112267528084591, 33418613008561),
  (-65947280693198, -1929710854292),
  (3260708881200, 92055329260),
  (-138290939060, -3727679396),
  (5135717545, 130613048),
  (-169659283, -4014717),
  (5048035, 109291)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 101 0 101 signs = dottieSharpBody101From0Ticks := by
  decide +kernel

theorem dottie_sharp_body101From0_moments (k : Fin 11) :
    (dottieSharpBody101From0Ticks.getD k (0,0)) =
      (dottiePairRowBlock (fun n => momentWeightRealTicks n k) 101 0 101,
       dottiePairRowBlock (fun n => momentWeightImagTicks n k) 101 0 101) := by
  have h := dottie_joint_moment_block_getD 101 0 101 signs k.isLt
  simpa only [joint_ticks, ← signs_eq] using h

#print axioms dottie_sharp_body101From0_moments

end QuarticModel.DottieFixedIntervals
