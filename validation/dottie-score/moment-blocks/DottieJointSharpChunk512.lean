import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x845124901125246140a44888905149128a05120924920e29140218828905120a481200a41449a5044926a4514510414

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 512 128 = dottiePackedPairSignBlock f 26858 512 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk512Ticks : List (ℤ × ℤ) := [
  (1633838070580822, 10146947145250574),
  (-1041413013722608, -6467789518963707),
  (331899802210529, 2061324488188735),
  (-70517957963155, -437971235062533),
  (11237086527007, 69792069555935),
  (-1432510154729, -8897265542512),
  (152181004833, 945204503372),
  (-13857229062, -86069290356),
  (1104079626, 6857703670),
  (-78193718, -485687234),
  (4984080, 30958291)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 512 128 signs = dottieSharpChunk512Ticks := by
  decide +kernel

theorem dottie_sharp_chunk512_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 512 128 =
      (dottieSharpChunk512Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 512 128 =
      (dottieSharpChunk512Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 512 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk512_moments

end QuarticModel.DottieFixedIntervals
