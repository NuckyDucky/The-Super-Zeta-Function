import DottieJointMomentScore

namespace QuarticModel.DottieFixedIntervals

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 24000000

private def signs : ℕ := 0x4944600924130a04920128a40140a041449c5124942928920a28904249240941214a2802452484122412892490512492

private theorem signs_eq (f : ℕ → ℤ) :
    dottiePairRowBlock f 26858 128 128 = dottiePackedPairSignBlock f 26858 128 128 signs :=
  dottie_pair_block_eq_of_checked_signs
    (witnesses := )
    (by decide +kernel) f

def dottieSharpChunk128Ticks : List (ℤ × ℤ) := [
  (-7052340753072074, 514009669904071),
  (4495151833132545, -327631232214206),
  (-1432601650319175, 104416541753397),
  (304379409147916, -22185134015189),
  (-48502749190250, 3535216951653),
  (6183116487668, -450671477087),
  (-656851589844, 47876547840),
  (59810893824, -4359521193),
  (-4765422197, 347346410),
  (337497022, -24599961),
  (-21512013, 1568007)
]

private theorem joint_ticks :
    dottieJointMomentBlock 11 26858 128 128 signs = dottieSharpChunk128Ticks := by
  decide +kernel

theorem dottie_sharp_chunk128_moments (k : Fin 11) :
    dottiePairRowBlock (fun n => momentWeightRealTicks n k) 26858 128 128 =
      (dottieSharpChunk128Ticks.getD k (0,0)).1 ∧
    dottiePairRowBlock (fun n => momentWeightImagTicks n k) 26858 128 128 =
      (dottieSharpChunk128Ticks.getD k (0,0)).2 := by
  have h := dottie_joint_moment_block_getD 26858 128 128 signs k.isLt
  rw [joint_ticks] at h
  constructor
  · rw [signs_eq]
    exact (congrArg Prod.fst h).symm
  · rw [signs_eq]
    exact (congrArg Prod.snd h).symm

#print axioms dottie_sharp_chunk128_moments

end QuarticModel.DottieFixedIntervals
