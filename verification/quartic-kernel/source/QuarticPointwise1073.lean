theorem cell_1094 (x : ℝ) (hx : x ∈ Icc (node 1094 : ℝ) (node 1095 : ℝ)) :
    (lowerK 1094 : ℝ) ≤ QuarticKernel.kernel x ∧
      QuarticKernel.kernel x ≤ (upperK 1094 : ℝ) := by
  have hdata : data[1094]?.getD (0,0) = (372,485) := by decide
  rw [lowerK, upperK, hdata]
  have h := cell_1094_scalar x (by norm_num [node] at hx ⊢; exact hx)
  norm_num at h ⊢
  exact h

end QuarticGrid
