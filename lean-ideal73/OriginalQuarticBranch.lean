import QuarticModel
import Mathlib.Tactic

/-! The field generated by a branch point of the quartic from the six coefficients. -/

namespace OriginalQuarticBranch

open NumberField QuarticModel

noncomputable section

def numerator {R : Type*} [Ring R] (x : R) : R := 465 * x^2 - 183*x - 659
def denominator {R : Type*} [Ring R] (x : R) : R := 155 * x^2 + 396*x - 936
def difference {R : Type*} [Ring R] (x : R) : R := numerator x - denominator x

private def a : K := 310 + 930*gaussianI
private def b : K := -579 - 366*gaussianI
private def c : K := 277 - 1318*gaussianI

private theorem a_ne : a ≠ 0 := by
  intro h
  unfold a at h
  have hfalse : (961000 : K) = 0 := by
    linear_combination (310 - 930*gaussianI)*h + 864900*gaussianI_sq
  norm_num at hfalse

private theorem discriminant_eq :
    b^2 - 4*a*c = -5045155 + 1027708*gaussianI := by
  unfold a b c
  linear_combination 5036916 * gaussianI_sq

/-- The chosen root of the Gaussian quadratic uses the square root `theta`. -/
def branchRoot : K := ((theta : K) - b) / (2*a)

theorem recoverTheta :
    (theta : K) = 2 * (310 + 930*gaussianI) * branchRoot + (-579 - 366*gaussianI) := by
  change (theta : K) = 2*a*(((theta : K) - b) / (2*a)) + b
  field_simp [a_ne]
  ring

theorem branchEquation :
    difference branchRoot + 2*gaussianI*numerator branchRoot = 0 := by
  have ht : (theta : K) = 2*a*branchRoot + b := recoverTheta
  have hsq : (2*a*branchRoot + b)^2 = b^2-4*a*c := by
    rw [← ht, theta_sq, discriminant_eq]
  have hz : (4*a)*(a*branchRoot^2 + b*branchRoot + c) = 0 := by
    linear_combination hsq
  have h := (mul_eq_zero.mp hz).resolve_left (mul_ne_zero (by norm_num) a_ne)
  unfold a b c at h
  unfold difference numerator denominator
  linear_combination h

theorem quartic_vanishes : (numerator branchRoot - denominator branchRoot)^2 +
    4*(numerator branchRoot)^2 = 0 := by
  change (difference branchRoot)^2 + 4*(numerator branchRoot)^2 = 0
  calc
    _ = (difference branchRoot + 2*gaussianI*numerator branchRoot) *
        (difference branchRoot - 2*gaussianI*numerator branchRoot) := by
      linear_combination (4*(numerator branchRoot)^2)*gaussianI_sq
    _ = 0 := by rw [branchEquation, zero_mul]

private theorem numerator_ne : numerator branchRoot ≠ 0 := by
  intro h
  have hd : difference branchRoot = 0 := by simpa [h] using branchEquation
  have hbez : (-425010*branchRoot + 127619)*numerator branchRoot +
      (637515*branchRoot + 748392)*difference branchRoot = 123203663 := by
    unfold difference numerator denominator
    ring
  rw [h, hd] at hbez
  norm_num at hbez

theorem recoverGaussianI : gaussianI = -difference branchRoot / (2*numerator branchRoot) := by
  apply (eq_div_iff (mul_ne_zero (by norm_num) numerator_ne)).mpr
  linear_combination branchEquation

/-- The same branch point that solves the original quartic generates its entire
quartic number field over the rationals. -/
theorem branch_generates : IntermediateField.adjoin ℚ {branchRoot} = ⊤ := by
  let S := IntermediateField.adjoin ℚ {branchRoot}
  have hr : branchRoot ∈ S := IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)
  have hr2 : branchRoot^2 ∈ S := by simpa [pow_two] using S.mul_mem hr hr
  have hN : numerator branchRoot ∈ S := by
    exact S.sub_mem (S.sub_mem (S.mul_mem (natCast_mem S 465) hr2)
      (S.mul_mem (natCast_mem S 183) hr)) (natCast_mem S 659)
  have hD : denominator branchRoot ∈ S := by
    exact S.sub_mem (S.add_mem (S.mul_mem (natCast_mem S 155) hr2)
      (S.mul_mem (natCast_mem S 396) hr)) (natCast_mem S 936)
  have hj : gaussianI ∈ S := by
    rw [recoverGaussianI]
    exact S.div_mem (S.neg_mem (S.sub_mem hN hD)) (S.mul_mem (natCast_mem S 2) hN)
  have ht : algebraMap (𝓞 K) K theta ∈ S := by
    change (theta : K) ∈ S
    rw [recoverTheta]
    exact S.add_mem (S.mul_mem (S.mul_mem (natCast_mem S 2)
      (S.add_mem (natCast_mem S 310) (S.mul_mem (natCast_mem S 930) hj))) hr)
      (S.sub_mem (S.neg_mem (natCast_mem S 579)) (S.mul_mem (natCast_mem S 366) hj))
  have hall : Algebra.adjoin ℚ {algebraMap (𝓞 K) K theta} ≤ S.toSubalgebra :=
    Algebra.adjoin_le (Set.singleton_subset_iff.mpr ht)
  apply top_unique
  intro y _
  apply hall
  rw [theta_generates]
  trivial

#print axioms quartic_vanishes
#print axioms branch_generates

end
end OriginalQuarticBranch
