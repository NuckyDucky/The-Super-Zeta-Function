private theorem witness_precise_log_error :
    |log (1+witnessRatio) - (witnessRatio-witnessRatio^2/2+witnessRatio^3/3)| ≤
      witnessRatio^4/(1-witnessRatio) := by
  have h₀ : 0 ≤ witnessRatio := by norm_num [witnessRatio]
  have h₁ : |-witnessRatio| < 1 := by norm_num [witnessRatio]
  have h := Real.abs_log_sub_add_sum_range_le h₁ 3
  have hsum : (∑ i ∈ Finset.range 3, (-witnessRatio)^(i+1)/(i+1)) =
      -(witnessRatio - witnessRatio^2/2 + witnessRatio^3/3) := by
    norm_num [Finset.sum_range_succ]
    ring
  rw [hsum,abs_neg,abs_of_nonneg h₀,sub_neg_eq_add,neg_add_eq_sub] at h
  exact h

theorem dottieHeight_precise_enclosure :
    4526119322477.94539331920732885690 < dottieHeight ∧
      dottieHeight < 4526119322477.94539331920732885700 := by
  obtain ⟨hlo,hhi⟩ := abs_le.mp witness_precise_log_error
  have hhigh : log (1+witnessRatio) ≤
      witnessRatio-witnessRatio^2/2+witnessRatio^3/3+witnessRatio^4/(1-witnessRatio) := by linarith
  have hlow : witnessRatio-witnessRatio^2/2+witnessRatio^3/3-witnessRatio^4/(1-witnessRatio) ≤
      log (1+witnessRatio) := by linarith
  constructor
  · unfold dottieHeight
    apply (lt_div_iff₀ heightDelta_pos).2
    unfold heightDelta
    calc
      _ ≤ 4526119322477.94539331920732885690 * (160 *
          (witnessRatio-witnessRatio^2/2+witnessRatio^3/3+witnessRatio^4/(1-witnessRatio))) := by gcongr
      _ < 2 * 3.14159265358979323846264338327950 := by norm_num [witnessRatio]
      _ < 2 * π := by linarith only [dottie_pi_lower]
  · unfold dottieHeight
    apply (div_lt_iff₀ heightDelta_pos).2
    unfold heightDelta
    calc
      _ < 2 * 3.14159265358979323846264338327951 := by linarith only [dottie_pi_upper]
      _ < 4526119322477.94539331920732885700 * (160 *
          (witnessRatio-witnessRatio^2/2+witnessRatio^3/3-witnessRatio^4/(1-witnessRatio))) := by
        norm_num [witnessRatio]
      _ ≤ _ := by gcongr

#print axioms dottieHeight_precise_enclosure

