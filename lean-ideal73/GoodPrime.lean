import Mathlib.NumberTheory.NumberField.Ideal.KummerDedekind
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.Tactic

/-! At 73 the order generated by the quartic root captures the full residue algebra. -/

namespace QuarticCoefficient

open NumberField Polynomial

/-- A rational integer that belongs to the conductor is a multiple of the exponent. -/
theorem exponent_dvd_conductor_integer {K : Type*} [Field K] [NumberField K] (θ : 𝓞 K)
    {c : ℤ} (hc : (c : 𝓞 K) ∈ conductor ℤ θ) :
    (RingOfIntegers.exponent θ : ℤ) ∣ c := by
  have h : c ∈ (conductor ℤ θ).under ℤ := by
    change algebraMap ℤ (𝓞 K) c ∈ conductor ℤ θ
    simpa using hc
  rw [← Int.ideal_span_absNorm_eq_self ((conductor ℤ θ).under ℤ),
    Ideal.mem_span_singleton] at h
  exact h

/-- For a primitive root, multiplying by its integral minimal polynomial's derivative
sends every algebraic integer into its generated order. -/
theorem derivative_mem_conductor {K : Type*} [Field K] [NumberField K] (θ : 𝓞 K)
    (hgen : Algebra.adjoin ℚ {algebraMap (𝓞 K) K θ} = ⊤) :
    aeval θ (derivative (minpoly ℤ θ)) ∈ conductor ℤ θ := by
  apply Ideal.mul_le_left (J := differentIdeal ℤ (𝓞 K))
  rw [conductor_mul_differentIdeal ℤ ℚ K θ hgen]
  exact Ideal.subset_span (Set.mem_singleton _)

/-- For the chosen primitive square root of the Gaussian discriminant,
73 does not divide its order exponent. The explicit integral multiple of the
derivative below reduces to 30 modulo 73. -/
theorem goodPrime73 {K : Type*} [Field K] [NumberField K] (θ : 𝓞 K)
    (hgen : Algebra.adjoin ℚ {algebraMap (𝓞 K) K θ} = ⊤)
    (hpoly : minpoly ℤ θ = X ^ 4 + 10090310 * X ^ 2 + 26509772707289) :
    ¬ 73 ∣ RingOfIntegers.exponent θ := by
  have hroot := minpoly.aeval ℤ θ
  rw [hpoly] at hroot
  have hf : θ^4 + 10090310 * θ^2 + 26509772707289 = 0 := by
    simpa [map_ofNat] using hroot
  have hderiv := derivative_mem_conductor θ hgen
  rw [hpoly] at hderiv
  have hd : 4 * θ^3 + 20180620 * θ ∈ conductor ℤ θ := by
    convert hderiv using 1
    norm_num [derivative_pow, derivative_mul, map_ofNat]
    ring
  have hprod := (conductor ℤ θ).mul_mem_left
    ((2 * θ^2 + 10090310) * (θ^3 + 10090310 * θ)) hd
  have hquad : θ^2 * (θ^2 + 10090310) = -26509772707289 := by
    linear_combination hf
  have hsquare : (2 * θ^2 + 10090310)^2 = -4224734933056 := by
    linear_combination 4 * hf
  have hid :
      ((2 * θ^2 + 10090310) * (θ^3 + 10090310 * θ)) * (4 * θ^3 + 20180620 * θ) =
      (223993525647716738596490368 : 𝓞 K) := by
    calc
      _ = 2 * (θ^2 * (θ^2 + 10090310)) * (2 * θ^2 + 10090310)^2 := by ring
      _ = _ := by rw [hquad, hsquare]; norm_num
  rw [hid] at hprod
  have hc := exponent_dvd_conductor_integer θ (c := 223993525647716738596490368)
    (by simpa using hprod)
  intro h
  exact (by decide : ¬ (73 : ℤ) ∣ 223993525647716738596490368)
    ((Int.natCast_dvd_natCast.mpr h).trans hc)

#print axioms goodPrime73

end QuarticCoefficient
