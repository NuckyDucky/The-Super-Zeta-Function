import QuarticSignedOrders
import Lean.Util.CollectAxioms

open Lean Elab Command in
run_cmd do
  let modules : Array Name := #[MODULES]
  let allowed : Array Name := #[`propext, `Classical.choice, `Quot.sound]
  let env ← getEnv
  let mut checked := 0
  let mut dependencies : CollectAxioms.State := {}
  for (name, info) in env.constants.toList do
    let some idx := env.getModuleIdxFor? name | continue
    unless modules.contains (env.header.moduleNames[idx.toNat]!) do continue
    match info with
    | .axiomInfo _ => throwError "Project axiom: {name}"
    | .thmInfo _ =>
      let (_, next) := ((CollectAxioms.collect name).run env).run dependencies
      for dep in next.axioms do
        unless allowed.contains dep do throwError "{name} depends on {dep}"
      dependencies := next
      checked := checked + 1
    | _ => pure ()
  if checked == 0 then throwError "No project theorems were audited"
  logInfo m!"Checked {checked} theorem declarations in the quartic order proof and its project dependencies."
