#time_score "lookup" in
theorem lookup_same_block : dottiePairRowBlock dottieQuickWeightTicks 10999 5120 256 =
    (4090118592412427998957558059046639506996421340519676158472401734661472 : ℤ) :=
  (dottie_pair_row_block_with_sign_eq dottieLookupRowSign dottieLookupRowSign_eq
    dottieQuickWeightTicks 10999 5120 256).symm.trans (by decide +kernel)

#time_score "witness" in
theorem witness_same_block : dottiePairRowBlock dottieQuickWeightTicks 10999 5120 256 =
    (4090118592412427998957558059046639506996421340519676158472401734661472 : ℤ) :=
  dottie_pair_block_of_witness (codes := sampleCodes) (by decide +kernel) (by decide +kernel)

theorem corrupted_root_rejected :
    dottieWitnessPairBlock dottieQuickWeightTicks 10999 5120
      ((0, sampleCodes.head!.2) :: sampleCodes.drop 1) = none := by decide +kernel

#print axioms lookup_same_block
#print axioms witness_same_block
